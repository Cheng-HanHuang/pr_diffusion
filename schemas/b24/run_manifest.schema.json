{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b24.run-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "scientific_execution_authorized", "count", "rows", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"type": "string"},
    "scientific_execution_authorized": {"const": false},
    "count": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_index", "image_id", "allocation", "screen_rank_sha256", "measurement_seed", "daps_solver_seeds", "sitcom_solver_seeds", "shard_id", "gpu_id", "gpu_uuid"],
        "properties": {
          "row_index": {"type": "integer", "minimum": 0},
          "image_id": {"type": "string", "pattern": "^[0-9]{5}$"},
          "allocation": {"const": "B24_SCREEN_ELIGIBLE"},
          "screen_rank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "measurement_seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "daps_solver_seeds": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "sitcom_solver_seeds": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "shard_id": {"type": "integer", "minimum": 0, "maximum": 3},
          "gpu_id": {"type": "integer", "minimum": 0, "maximum": 3},
          "gpu_uuid": {"type": "string"}
        }
      }
    }
  }
}
