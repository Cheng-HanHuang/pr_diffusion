{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b24.completion-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "identity", "attempts", "terminal_candidates", "metrics", "timing", "memory"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "COMPLETE"},
    "identity": {
      "type": "object",
      "required": ["run_manifest_sha256", "image_id", "measurement_sha256", "source_identity_sha256", "solver_seeds"],
      "additionalProperties": true
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["attempt_id", "status", "reason"],
        "additionalProperties": true
      }
    },
    "terminal_candidates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["method", "replicate", "solver_seed", "terminal_sha256", "raw_orientation_rgb_psnr_db", "ssim", "lpips"],
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "required": ["daps_best_raw_psnr_db", "sitcom_best_raw_psnr_db", "good25_class", "good26", "good28"],
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": ["gpu_active_seconds", "wall_seconds", "work_fre", "terminal_candidate_count", "branch_count"],
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "required": ["torch_peak_allocated_mib", "torch_peak_reserved_mib", "nvidia_smi_process_peak_mib"],
      "additionalProperties": true
    }
  }
}
